# Clave común para ChatOpenAI, visión, Whisper, DSPy y los agentes de extras.
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_AGENT_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# Gemini se usa solo al elegir PROVEEDOR_VISION=gemini en los casos de L1.
GEMINI_API_KEY=your-gemini-key-here
PROVEEDOR_VISION=openai

# LM Studio usa un servidor local OpenAI-compatible; no requiere una clave de OpenAI.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-vl-3b-instruct
LMSTUDIO_API_KEY=lm-studio

# Observabilidad de Langfuse para L5 y el proyecto LegalMove.
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Variables usadas por los ejemplos de Docker y material didáctico.
APP_ENV=desarrollo
MODEL_NAME=clasificador-tiny
PIM4_USE_REAL_API=0
PIM4_USE_LANGFUSE=0

# URL opcional del MCP de contratos publicado por FastMCP mediante Streamable HTTP.
# Vacía: los ejercicios usan un servidor FastMCP real por STDIO local.
# Publicado: usar una URL HTTP/HTTPS terminada en /mcp/.
FASTMCP_CONTRATOS_URL=

# Ejemplo FastMCP de una API propia: ajustar al backend real de la organización.
API_PROPIA_BASE_URL=https://api.tu-organizacion.com
API_PROPIA_TOKEN=your-internal-api-token
